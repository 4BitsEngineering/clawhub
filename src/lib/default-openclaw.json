{
  "$schema": "https://docs.openclaw.ai/schema/openclaw.json",
  "bindings": [],
  "gateway": {
    "mode": "local",
    "auth": {
      "mode": "token",
      "token": "__GATEWAY_TOKEN__"
    },
    "controlUi": {
      "allowInsecureAuth": true,
      "dangerouslyDisableDeviceAuth": true
    },
    "http": {
      "endpoints": {
        "chatCompletions": {
          "enabled": true
        }
      }
    },
    "reload": {
      "mode": "hybrid"
    },
    "remote": {
      "token": "__GATEWAY_TOKEN__"
    }
  },
  "discovery": {
    "mdns": {
      "mode": "off"
    }
  },
  "channels": {
    "slack": {
      "enabled": false
    },
    "whatsapp": {
      "enabled": false
    }
  },
  "env": {},
  "logging": {
    "level": "info"
  },
  "session": {
    "dmScope": "per-channel-peer",
    "reset": {
      "mode": "daily",
      "atHour": 4,
      "idleMinutes": 10080
    },
    "maintenance": {
      "mode": "enforce",
      "pruneAfter": "30d",
      "maxEntries": 500
    },
    "agentToAgent": {
      "maxPingPongTurns": 5
    }
  },
  "agents": {
    "defaults": {
      "model": {
      },
      "models": {
      },
      "thinkingDefault": "off",
      "reasoningDefault": "off",
      "contextInjection": "continuation-skip",
      "bootstrapMaxChars": 25000,
      "bootstrapTotalMaxChars": 75000,
      "heartbeat": {
        "every": "55m"
      },
      "compaction": {
        "mode": "safeguard",
        "keepRecentTokens": 20000,
        "reserveTokens": 20000,
        "midTurnPrecheck": {
          "enabled": true
        }
      },
      "memorySearch": {
        "enabled": true,
        "provider": "none"
      },
      "subagents": {
        "maxSpawnDepth": 2,
        "maxChildrenPerAgent": 5,
        "maxConcurrent": 8,
        "runTimeoutSeconds": 1800,
        "archiveAfterMinutes": 60,
        "allowAgents": [
          "*"
        ],
        "delegationMode": "prefer"
      },
      "params": {
        "cacheRetention": "long"
      },
      "contextPruning": {
        "mode": "cache-ttl",
        "ttl": "1h"
      },
      "timeoutSeconds": 2700,
      "maxConcurrent": 6,
      "imageGenerationModel": {
      },
      "skipBootstrap": true
    },
    "list": []
  },
  "messages": {},
  "tools": {
    "profile": "coding",
    "alsoAllow": [
      "message",
      "tts",
      "exec"
    ],
    "deny": [
      "code_execution",
      "cron",
      "gateway",
      "nodes",
      "update_plan"
    ],
    "web": {
      "search": {
        "enabled": true
      }
    },
    "loopDetection": {
      "enabled": true,
      "detectors": {
        "pingPong": true,
        "genericRepeat": false,
        "knownPollNoProgress": false
      }
    }
  },
  "plugins": {
    "allow": [
      "whatsapp",
      "browser",
      "canvas",
      "device-pair",
      "file-transfer",
      "memory-core",
      "minimax",
      "phone-control",
      "talk-voice",
      "ollama",
      "duckduckgo",
      "brave",
      "openai",
      "acpx",
      "litellm",
      "xiaomi",
      "n8n",
      "config-guard",
      "fs-approval-guard",
      "spawn-cwd-guard",
      "web-egress-guard",
      "exec-guard",
      "asset-downloader",
      "huggingface"
    ],
    "load": {
      "paths": [
        "__STACK_ROOT__/autonomous-agents/plugins/n8n",
        "__STACK_ROOT__/autonomous-agents/plugins/config-guard",
        "__STACK_ROOT__/autonomous-agents/plugins/fs-approval-guard",
        "__STACK_ROOT__/autonomous-agents/plugins/spawn-cwd-guard",
        "__STACK_ROOT__/autonomous-agents/plugins/web-egress-guard",
        "__STACK_ROOT__/autonomous-agents/plugins/exec-guard",
        "__STACK_ROOT__/autonomous-agents/plugins/asset-downloader"
      ]
    },
    "deny": [
      "openai",
      "anthropic",
      "google",
      "groq",
      "mistral",
      "openrouter",
      "xai",
      "together",
      "deepseek",
      "github-copilot",
      "perplexity",
      "moonshot"
    ],
    "entries": {
      "xiaomi": {
        "enabled": true
      },
      "ollama": {
        "enabled": true
      },
      "duckduckgo": {
        "config": {
          "webSearch": {
            "region": "es-es",
            "safeSearch": "moderate"
          }
        },
        "enabled": true
      },
      "brave": {
        "enabled": false
      },
      "openai": {
        "enabled": true
      },
      "acpx": {
        "enabled": true,
        "config": {
          "pluginToolsMcpBridge": false,
          "openClawToolsMcpBridge": false,
          "mcpServers": {}
        }
      },
      "n8n": {
        "enabled": true,
        "config": {
          "baseUrl": ""
        }
      },
      "browser": {
        "enabled": true
      },
      "whatsapp": {
        "enabled": true
      },
      "litellm": {
        "enabled": true
      },
      "minimax": {
        "enabled": true
      },
      "memory-core": {
        "config": {
          "dreaming": {
            "enabled": true,
            "frequency": "0 3 * * *"
          }
        }
      }
    }
  },
  "skills": {
    "load": {
      "extraDirs": [
        "__STACK_ROOT__/autonomous-agents/skills",
        "__STACK_ROOT__/autonomous-agents/overlays/hello-world/skills",
        "__STACK_ROOT__/ai-office/skills"
      ]
    },
    "entries": {
      "n8n_workflows": {
        "enabled": true
      },
      "jira-nttdata": {
        "enabled": false
      },
      "coding-agent": {
        "enabled": true
      },
      "github": {
        "enabled": true
      },
      "gh-issues": {
        "enabled": true
      },
      "clawflow": {
        "enabled": true
      },
      "clawflow-inbox-triage": {
        "enabled": true
      },
      "healthcheck": {
        "enabled": true
      },
      "model-usage": {
        "enabled": true
      },
      "nano-pdf": {
        "enabled": true
      },
      "session-logs": {
        "enabled": true
      },
      "skill-creator": {
        "enabled": true
      },
      "slack": {
        "enabled": true
      },
      "summarize": {
        "enabled": true
      },
      "xurl": {
        "enabled": true
      },
      "notion": {
        "enabled": true
      },
      "trello": {
        "enabled": true
      },
      "1password": {
        "enabled": false
      },
      "apple-notes": {
        "enabled": false
      },
      "apple-reminders": {
        "enabled": false
      },
      "bear-notes": {
        "enabled": false
      },
      "blogwatcher": {
        "enabled": false
      },
      "blucli": {
        "enabled": false
      },
      "bluebubbles": {
        "enabled": false
      },
      "camsnap": {
        "enabled": false
      },
      "canvas": {
        "enabled": false
      },
      "clawhub": {
        "enabled": false
      },
      "discord": {
        "enabled": false
      },
      "eightctl": {
        "enabled": false
      },
      "gemini": {
        "enabled": false
      },
      "gifgrep": {
        "enabled": false
      },
      "gog": {
        "enabled": false
      },
      "goplaces": {
        "enabled": false
      },
      "himalaya": {
        "enabled": false
      },
      "imsg": {
        "enabled": false
      },
      "mcporter": {
        "enabled": false
      },
      "node-connect": {
        "enabled": false
      },
      "obsidian": {
        "enabled": false
      },
      "openai-whisper": {
        "enabled": false
      },
      "openai-whisper-api": {
        "enabled": false
      },
      "openhue": {
        "enabled": false
      },
      "oracle": {
        "enabled": false
      },
      "ordercli": {
        "enabled": false
      },
      "peekaboo": {
        "enabled": false
      },
      "sag": {
        "enabled": false
      },
      "sherpa-onnx-tts": {
        "enabled": false
      },
      "songsee": {
        "enabled": false
      },
      "sonoscli": {
        "enabled": false
      },
      "spotify-player": {
        "enabled": false
      },
      "things-mac": {
        "enabled": false
      },
      "tmux": {
        "enabled": false
      },
      "video-frames": {
        "enabled": false
      },
      "voice-call": {
        "enabled": false
      },
      "wacli": {
        "enabled": false
      },
      "weather": {
        "enabled": false
      },
      "linkedin-post-method": {
        "enabled": true
      },
      "excel-professional-formatting": {
        "enabled": true
      },
      "pptx-professional-formatting": {
        "enabled": true
      },
      "docx-professional-formatting": {
        "enabled": true
      },
      "pdf-professional-processing": {
        "enabled": true
      },
      "audio-spot-production": {
        "enabled": true
      }
    },
    "workshop": {
      "autonomous": {
        "enabled": true
      },
      "approvalPolicy": "pending",
      "maxPending": 50,
      "maxSkillBytes": 40000
    }
  },
  "models": {
    "mode": "replace",
    "providers": {
    }
  },
  "meta": {
    "lastTouchedVersion": "2026.6.1"
  },
  "mcp": {
    "sessionIdleTtlMs": 0,
    "servers": {}
  },
  "commands": {
    "ownerAllowFrom": []
  },
  "browser": {
    "ssrfPolicy": {
      "dangerouslyAllowPrivateNetwork": false,
      "allowedHostnames": [
        "localhost",
        "127.0.0.1"
      ]
    },
    "enabled": true
  },
  "secrets": {
    "providers": {
      "bridge_tokens": {
        "source": "exec",
        "command": "__NODE_BIN__",
        "allowInsecurePath": true,
        "args": [
          "__STACK_ROOT__/autonomous-agents/work-console/bridge/scripts/secrets-exec-resolver.js"
        ],
        "passEnv": [
          "BRIDGE_DATA_DIR",
          "BRIDGE_ENCRYPTION_KEY",
          "HOME",
          "USERPROFILE",
          "APPDATA"
        ],
        "trustedDirs": [
          "__NODE_DIR__",
          "__STACK_ROOT__/autonomous-agents/work-console/bridge/scripts"
        ]
      }
    }
  },
  "wizard": {
    "lastRunMode": "local"
  },
  "cron": {
    "sessionRetention": "24h"
  }
}
