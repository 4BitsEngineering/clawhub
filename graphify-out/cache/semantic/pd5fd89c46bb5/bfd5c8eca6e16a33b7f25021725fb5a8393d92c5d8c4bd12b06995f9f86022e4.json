{"nodes": [{"id": "docs_superpowers_plans_2026_06_14_clawhub_kill_switch_plan", "label": "clawhub Kill-switch Plan", "file_type": "document", "source_file": "docs/superpowers/plans/2026-06-14-clawhub-kill-switch.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_plans_2026_06_14_clawhub_kill_switch_kill_switch", "label": "Kill-switch (suspend/resume by subscription)", "file_type": "rationale", "source_file": "docs/superpowers/plans/2026-06-14-clawhub-kill-switch.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The cut is a reversible 'real suspended mode' (gate on tasks/chat) that does not kill processes (JJ's decision); heartbeat stays HTTP 200 while suspended so the instance keeps being monitored; reuses existing pairing, heartbeat, command auth and admin endpoints."}, {"id": "docs_superpowers_plans_2026_06_14_clawhub_kill_switch_firm_status", "label": "Firm.status field (active | suspended)", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-06-14-clawhub-kill-switch.md", "source_location": "Task 1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_plans_2026_06_14_clawhub_kill_switch_bridge_suspension_gate", "label": "Bridge Suspension Gate (402 subscription_suspended)", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-06-14-clawhub-kill-switch.md", "source_location": "Task 3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Persistent file flag (<BRIDGE_DATA_DIR>/.suspended) survives restarts; task/chat creation returns 402 subscription_suspended before dispatch; health endpoint exposes suspended state for a web banner."}, {"id": "docs_superpowers_plans_2026_06_14_clawhub_kill_switch_dispatcher_translation", "label": "Dispatcher firm_status \u2192 bridge suspend/resume trans