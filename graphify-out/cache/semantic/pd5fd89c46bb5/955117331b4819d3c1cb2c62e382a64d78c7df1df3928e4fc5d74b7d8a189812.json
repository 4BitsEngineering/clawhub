{"nodes": [{"id": "spec_clawhub_v0_spec", "label": "clawhub v0 Specification", "file_type": "document", "source_file": "SPEC.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "spec_phone_home_protocol", "label": "Phone-home Protocol", "file_type": "rationale", "source_file": "SPEC.md", "source_location": "SPEC.md \u00a73", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Instances report telemetry every 60s via Bearer-authenticated heartbeats; commands array reserved empty in v0 for forward-compat (restart, update in v0.5+). Heartbeats accumulate as time points, never deduplicated."}, {"id": "spec_pair_endpoint", "label": "POST /api/v0/pair (Pairing Flow)", "file_type": "concept", "source_file": "SPEC.md", "source_location": "SPEC.md \u00a73.1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Single-use human-readable 6-8 char code valid 10 min exchanged for a long-lived hashed instance_token; keeps worker onboarding to typing one code in a first-run wizard."}, {"id": "spec_heartbeat_endpoint", "label": "POST /api/v0/heartbeat (Telemetry)", "file_type": "concept", "source_file": "SPEC.md", "source_location": "SPEC.md \u00a73.2", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "spec_firm", "label": "Firm (tenant entity)", "file_type": "concept", "source_file": "SPEC.md", "source_location": "SPEC.md \u00a72", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "spec_user", "label": "User entity (operator / firm_admin)", "file_type": "concept", "source_file": "SPEC.md", "source_location": "SPEC.md \u00a72", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "spec_instance", "label": "Instance entity", "file_type": "concept", "source_file": "SPEC.md", "source_location": "SPEC.md \u00a72", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "instance_token stored hashed (bcrypt/argon2), never plaintext; status online/offline/unpaired computed in query from last_heartbeat_at with 3-min threshold, not stored \u2014 v0 accepts polling lag over realtime complexity."}, {"id": "spec_heartbeat", "label": "Heartbeat entity", "file_type": "concept", "source_file": "SPEC.md", "source_location": "SPEC.md \u00a72", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "raw_payload jsonb column kept for forward compatibility so unknown telemetry fields survive schema evolution."}, {"id": "spec_pairingtoken", "label": "PairingToken entity", "file_type": "concept", "source_file": "SPEC.md", "source_location": "SPEC.md \u00a72", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "spec_magic_link_auth", "label": "Magic Link Auth (NextAuth, no password)", "file_type": "rationale", "source_file": "SPEC.md", "source_location": "SPEC.md \u00a74", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Passwordless magic link chosen to avoid password management for a tiny v0 user base; operators seeded manually, firm_admins created by operators, workers never log into clawhub \u2014 only into clawgents-desktop."}, {"id": "spec_admin_console", "label": "Admin Console (operator + firm screens)", "file_type": "concept", "source_file": "SPEC.md", "source_location": "SPEC.md \u00a75", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "7 functional screens, zero polish \u2014 scope deliberately capped for a 2-week v0 demoable for the first in-situ install."}, {"id": "spec_multi_tenant_column_based", "label": "Column-based Multi-tenancy (firm_id)", "file_type": "rationale", "source_file": "SPEC.md", "source_location": "SPEC.md \u00a76, \u00a711", "source_url": null, "captured_at": null, "author": null, "contributor": nul