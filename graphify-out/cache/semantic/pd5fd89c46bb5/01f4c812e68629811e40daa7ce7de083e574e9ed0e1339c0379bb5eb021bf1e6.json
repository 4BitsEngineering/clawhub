{"nodes": [{"id": "docs_superpowers_specs_2026_07_11_first_pair_sin_baseline_design_first_pair_block", "label": "Block First-Pair for Firms Without Promoted Baseline", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-07-11-first-pair-sin-baseline-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A firm without a promoted FirmBaseline can emit pairing codes but the installer always fails at provisioning, discovered days later on the client machine (real case 11-jul). Decision (JJ): disable first-pair with banner; re-pair only shows a warning. Server actions re-check the rule because disabled buttons are not a security barrier (server actions are independent POST endpoints). No changes to v0/* APIs, no migrations; clawhub cannot auto-create baselines because only the configurator wizard fabricates the package."}, {"id": "docs_superpowers_specs_2026_07_11_first_pair_sin_baseline_design_promoted_baseline", "label": "Promoted Baseline (FirmBaseline.isPromoted)", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-07-11-first-pair-sin-baseline-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_07_11_first_pair_sin_baseline_design_firmhaspromotedbaseline", "label": "firmHasPromotedBaseline Helper", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-07-11-first-pair-sin-baseline-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_superpowers_specs_2026_07_11_first_pair_sin_baseline_design_first_pair_block", "target": "agents_nextjs_agent_rules", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-07-11-first-pair-sin-baseline-design.md", "source_location": null, "weight": 1.0}, {"source"