# AI-Office Center — Environment variables
# Copy to .env.local and fill with real values.
# Never commit .env / .env.local — only this example.

# -----------------------------------------------------------------------------
# Database — Supabase Postgres
# -----------------------------------------------------------------------------
# Get from Supabase Dashboard → Project Settings → Database → Connection string
# Two connection modes:
#   - Transaction pooler (port 6543, pgbouncer) → DATABASE_URL  for app runtime
#   - Session pooler / direct (port 5432)       → DIRECT_URL   for Prisma migrate
#
# For Supabase, both come from the dashboard. Use the project-ref-prefixed user
# (e.g. postgres.pjjixcylawrqimtdzjzy).

DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# -----------------------------------------------------------------------------
# Auth.js (NextAuth v5)
# -----------------------------------------------------------------------------
# Generate with:  openssl rand -base64 32
AUTH_SECRET="REPLACE_ME_RANDOM_32_BYTES"

# Local dev: http://localhost:3000 (o el puerto que uses).
# Producción (Vercel): la URL pública https, p. ej. https://ia-suite-chi.vercel.app
AUTH_URL="http://localhost:3000"

# Trust the host header in production (required behind Vercel/proxies)
AUTH_TRUST_HOST="true"

# Login de validación en /login (botones "Entrar como ..."), sin verificación.
# SOLO desarrollo. En producción: NO definir esta variable (o ponerla a false)
# — sin ella, la única vía de acceso es el magic link por email.
DEV_AUTH_ENABLED="true"

# -----------------------------------------------------------------------------
# Email (Resend) — magic links de login + emails transaccionales
# -----------------------------------------------------------------------------
# Sin RESEND_API_KEY todo funciona en modo dev: el magic link se loguea en la
# consola del server y los emails se simulan. Con la key, envío real.
# El dominio del remitente debe estar verificado en Resend (SPF/DKIM).
RESEND_API_KEY="re_xxxx"
RESEND_FROM="AI-Office <info@iaofi.com>"

# -----------------------------------------------------------------------------
# App pública
# -----------------------------------------------------------------------------
# URL pública de la app — necesaria para links de tracking de campañas
NEXT_PUBLIC_APP_URL="https://ia-suite-chi.vercel.app"

# -----------------------------------------------------------------------------
# SMS (Twilio) — envío de campañas por SMS (opcional; sin esto, se simula)
# -----------------------------------------------------------------------------
TWILIO_ACCOUNT_SID="ACxxxx"
TWILIO_AUTH_TOKEN="xxxx"
TWILIO_FROM="+34900000000"

# -----------------------------------------------------------------------------
# Pagos (Stripe) — checkout de la landing de venta
# -----------------------------------------------------------------------------
# Sin la key, el checkout queda deshabilitado (la landing sigue visible).
STRIPE_SECRET_KEY="sk_test_xxxx"
# STRIPE_WEBHOOK_SECRET NO va aquí: el webhook vive en una Supabase Edge
# Function y su secret se configura con `supabase secrets set` (ver
# ACCIONES-PENDIENTES.md).
